# Supabase / Postgres connection (Session pooler URL works fine).
# IMPORTANT: use a NEW Supabase project, or keep "?schema=shopzone" at the end so ShopZone gets its own
# schema and never touches the tables of another app (like your Daynight store).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=shopzone"

# Random string, 16+ characters. Generate one with:  openssl rand -hex 32
SESSION_SECRET=""

# Product image uploads (optional). If these are empty, images are saved to public/uploads
# (fine for local testing, NOT for hosting on Vercel).
# In Supabase: Storage -> New bucket named "products" -> make it Public.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Currency shown in the shop. PayHere card payments work with LKR or USD only.
NEXT_PUBLIC_CURRENCY_CODE="LKR"
NEXT_PUBLIC_CURRENCY_LABEL="Rs"

# PayHere card payments (optional). Leave empty to offer Cash on Delivery only.
# Sandbox first: https://sandbox.payhere.lk  ->  Settings -> Domains & Credentials -> add your domain
# The merchant secret belongs to the domain you registered, so register the same domain as SITE_URL.
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_SANDBOX="true"           # set to "false" only when you go live with real money
# Public address of this site (no trailing slash). PayHere must be able to reach it to confirm payments,
# so http://localhost:3000 will NOT work for the confirmation step (use a tunnel such as ngrok while testing).
SITE_URL=""

# Secret for the daily clean-up job that cancels unpaid card orders (Vercel cron sends it automatically).
# Set a long random value (openssl rand -hex 32) in your hosting settings. Empty = the job is switched off.
CRON_SECRET=""

# Timezone used to split sales into days on the dashboard charts
SHOP_TIMEZONE="Asia/Colombo"

# Email (optional): password reset and order confirmation emails, sent through Resend (resend.com, free plan available).
# Without these two, no emails are sent. In development the reset link is printed in the terminal instead.
# The test sender onboarding@resend.dev is usually limited to your own email address. To email real customers
# you will normally need to verify your own domain in Resend (check Resend's docs for the current rules).
RESEND_API_KEY=""
MAIL_FROM="ShopZone <onboarding@resend.dev>"
